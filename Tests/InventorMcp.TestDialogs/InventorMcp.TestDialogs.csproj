<Project Sdk="Microsoft.NET.Sdk">

	<!-- Shows real dialogs in a separate process, so the desktop tests read them from outside, as the server reads Inventor. -->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>InventorMcp.TestDialogs</RootNamespace>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

</Project>
