<?xml version="1.0" encoding="utf-8" ?>
<!--
	Describes the add-in bundle to Autodesk's ApplicationPlugins loader.
	ModuleName must point at the .addin manifest inside Contents.
	Platform must be "Inventor" for an Inventor add-in.
-->
<ApplicationPackage
	SchemaVersion="1.0"
	Version="1.0"
	ProductCode="{19D2C9DE-6AC2-41E1-A9CF-2E0849E1306B}"
	Name="Inventor MCP Bridge"
	Description="Exposes the running Inventor session to the Inventor MCP server over a named pipe."
	Author="Tyler Warner">
	<Components>
		<RuntimeRequirements OS="Win64" Platform="Inventor" />
		<ComponentEntry
			LoadOnAutoCADStartup="False"
			LoadOnCommandInvocation="False"
			AppDescription="Inventor MCP Bridge add-in."
			ModuleName="./Contents/InventorMcp.AddIn.addin"
			AppName="InventorMcp.AddIn" />
	</Components>
	<EnvironmentVariables>
	</EnvironmentVariables>
</ApplicationPackage>
