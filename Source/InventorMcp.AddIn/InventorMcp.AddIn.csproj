<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Selected by AutodeskVersion. The -windows suffix is needed for the COM interop surface. -->
		<TargetFramework>$(AddInTargetFramework)</TargetFramework>

		<!--
			Three releases build from one project, so the output path must separate them.
			Sharing a folder would let the last build win, and a manifest would then point at an assembly
			built for a runtime other than the one that loaded it.
		-->
		<AddInVersionOutputDir>$(ProjectDir)bin\$(Configuration)\$(AutodeskVersion)\</AddInVersionOutputDir>

		<!-- With the loader, the add-in sits one level below it, out of reach of the default context. -->
		<OutputPath Condition="'$(UseAddInLoader)' == 'true'">$(AddInVersionOutputDir)App\</OutputPath>
		<OutputPath Condition="'$(UseAddInLoader)' != 'true'">$(AddInVersionOutputDir)</OutputPath>

		<!-- The assembly the manifest names: the loader where one is used, otherwise the add-in itself. -->
		<ManifestAssemblyFileName Condition="'$(UseAddInLoader)' == 'true'">InventorMcp.AddIn.Loader.dll</ManifestAssemblyFileName>
		<ManifestAssemblyFileName Condition="'$(UseAddInLoader)' != 'true'">InventorMcp.AddIn.dll</ManifestAssemblyFileName>

		<RootNamespace>InventorMcp.AddIn</RootNamespace>
		<AssemblyName>InventorMcp.AddIn</AssemblyName>
		<AssemblyTitle>Inventor MCP Bridge</AssemblyTitle>
		<Description>Exposes the running Inventor session to the Inventor MCP server over a named pipe.</Description>
		<Product>Inventor MCP Bridge</Product>

		<EnableComHosting>false</EnableComHosting>
		<!-- Inventor discovers the add-in through the .addin manifest, so the class only has to be COM visible. -->
		<ComVisible>false</ComVisible>

		<!-- A Library cannot be launched, so F5 starts Inventor with the debugger attached instead. -->
		<OutputType>Library</OutputType>
		<StartAction>Program</StartAction>
		<StartProgram>$(InventorInstallDir)\Bin\Inventor.exe</StartProgram>

		<!-- Package assemblies must land beside the add-in so the isolated load context can resolve them. -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GenerateDependencyFile>true</GenerateDependencyFile>
		<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\InventorMcp.Contracts\InventorMcp.Contracts.csproj" />
	</ItemGroup>

	<!-- Build order only. The loader must never be a compile time reference, or it would load beside the add-in. -->
	<ItemGroup Condition="'$(UseAddInLoader)' == 'true'">
		<ProjectReference Include="..\InventorMcp.AddIn.Loader\InventorMcp.AddIn.Loader.csproj" ReferenceOutputAssembly="false" Private="false" />
	</ItemGroup>

	<!--
		Private=false is load bearing, not tidiness.
		Under an isolated AssemblyLoadContext the interop must always resolve from Inventor itself,
		while this add-in's own package dependencies resolve from its output folder.
		Shipping a second copy of the interop would give two managed identities for the same COM types.
		EmbedInteropTypes=false is required because embedded types cannot carry the event interfaces the activity feed subscribes to.
		The HintPath points at the vendored copy under Libs so a build agent without Inventor installed can still build.
	-->
	<ItemGroup>
		<Reference Include="Autodesk.Inventor.Interop">
			<HintPath>$(InventorInteropDir)\Autodesk.Inventor.Interop.dll</HintPath>
			<EmbedInteropTypes>false</EmbedInteropTypes>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="InventorMcp.AddIn.addin.template" />
	</ItemGroup>

	<PropertyGroup>
		<!-- Per user, version dependent. Serves only the release being built. -->
		<InventorAddinsDir>$(AppData)\Autodesk\Inventor $(AutodeskVersion)\Addins</InventorAddinsDir>

		<!--
			Per user, version independent. One folder holds every release's build, and Inventor discards the
			manifests that do not match its own version before touching an assembly.
		-->
		<InventorBundleDir>$(AppData)\Autodesk\ApplicationPlugins\$(AssemblyName)</InventorBundleDir>
		<InventorBundleContentsDir>$(InventorBundleDir)\Contents\$(AutodeskVersion)</InventorBundleContentsDir>
	</PropertyGroup>

	<!--
		Places the loader beside App\, and removes anything else from that level.
		A stale add-in DLL beside the loader could load into the default context and defeat the isolation.
	-->
	<Target Name="StageAddInLoader" AfterTargets="Build" Condition="'$(UseAddInLoader)' == 'true'">
		<PropertyGroup>
			<LoaderOutputDir>$(ProjectDir)..\InventorMcp.AddIn.Loader\bin\$(Configuration)\$(AutodeskVersion)\</LoaderOutputDir>
		</PropertyGroup>
		<ItemGroup>
			<StaleLoaderLevelFile Include="$(AddInVersionOutputDir)*.*" Exclude="$(AddInVersionOutputDir)$(ManifestAssemblyFileName)" />
		</ItemGroup>
		<Delete Files="@(StaleLoaderLevelFile)" />
		<Copy SourceFiles="$(LoaderOutputDir)$(ManifestAssemblyFileName)" DestinationFolder="$(AddInVersionOutputDir)" />
	</Target>

	<!--
		Development deployment. Opt in with -p:DeployAddIn=true.
		The manifest is written outside the repository, so it must never happen on an ordinary build.
		It points straight at the build output, so a rebuild needs no redeployment.
		The output path carries the version, so several releases can be installed at once.
	-->
	<Target Name="DeployAddInManifest" AfterTargets="Build;StageAddInLoader" Condition="'$(DeployAddIn)' == 'true'">
		<Warning
			Condition="'$(IsInventorInstalled)' != 'true'"
			Text="Inventor $(AutodeskVersion) is not installed at $(InventorInstallDir). The manifest was still written, and it will be ignored until that release is installed." />
		<PropertyGroup>
			<AddInAssemblyPath>$([System.IO.Path]::GetFullPath('$(AddInVersionOutputDir)$(ManifestAssemblyFileName)'))</AddInAssemblyPath>
			<AddInManifestText>$([System.IO.File]::ReadAllText('$(ProjectDir)InventorMcp.AddIn.addin.template').Replace('ASSEMBLY_PATH', '$(AddInAssemblyPath)').Replace('SOFTWARE_VERSION', '$(InventorSoftwareVersion)'))</AddInManifestText>
		</PropertyGroup>
		<MakeDir Directories="$(InventorAddinsDir)" />
		<WriteLinesToFile
			File="$(InventorAddinsDir)\$(AssemblyName).addin"
			Lines="$(AddInManifestText)"
			Overwrite="true"
			WriteOnlyWhenDifferent="true" />
		<Message Importance="high" Text="Deployed the Inventor $(AutodeskVersion) add-in manifest to $(InventorAddinsDir), pointing at $(AddInAssemblyPath)" />
	</Target>

	<!--
		Release deployment. Opt in with -p:DeployBundle=true.
		Produces the self contained bundle layout an installer would ship.
		Run once per release: each run adds its own manifest and Contents subfolder, leaving the others alone.
	-->
	<Target Name="DeployAddInBundle" AfterTargets="Build;StageAddInLoader" Condition="'$(DeployBundle)' == 'true'">
		<PropertyGroup>
			<!-- Relative to the manifest at the bundle root, the form Autodesk's own bundles use. -->
			<BundleAssemblyPath>.\Contents\$(AutodeskVersion)\$(ManifestAssemblyFileName)</BundleAssemblyPath>
			<BundleManifestText>$([System.IO.File]::ReadAllText('$(ProjectDir)InventorMcp.AddIn.addin.template').Replace('ASSEMBLY_PATH', '$(BundleAssemblyPath)').Replace('SOFTWARE_VERSION', '$(InventorSoftwareVersion)'))</BundleManifestText>
		</PropertyGroup>
		<ItemGroup>
			<BundlePayload Include="$(AddInVersionOutputDir)**\*.*" Exclude="$(AddInVersionOutputDir)**\*.msi" />
		</ItemGroup>
		<!-- No PackageContents.xml: Inventor discovers .addin manifests under ApplicationPlugins directly. -->
		<!-- Replaced whole, so a file from an earlier layout cannot linger beside the loader. -->
		<RemoveDir Directories="$(InventorBundleContentsDir)" />
		<MakeDir Directories="$(InventorBundleContentsDir)" />
		<Copy SourceFiles="@(BundlePayload)" DestinationFolder="$(InventorBundleContentsDir)\%(RecursiveDir)" />
		<WriteLinesToFile
			File="$(InventorBundleDir)\$(AssemblyName).$(AutodeskVersion).addin"
			Lines="$(BundleManifestText)"
			Overwrite="true"
			WriteOnlyWhenDifferent="true" />
		<Message Importance="high" Text="Deployed the Inventor $(AutodeskVersion) build to $(InventorBundleContentsDir)" />
	</Target>

	<!-- Removes only this release's share, so cleaning 2025 leaves the 2027 build in the same bundle. -->
	<Target Name="CleanAddInDeployment" AfterTargets="Clean">
		<Delete Files="$(InventorAddinsDir)\$(AssemblyName).addin" />
		<Delete Files="$(InventorBundleDir)\$(AssemblyName).$(AutodeskVersion).addin" />
		<RemoveDir Directories="$(InventorBundleContentsDir)" />
	</Target>

</Project>
