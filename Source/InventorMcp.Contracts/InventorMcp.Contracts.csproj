<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			The wire contract is the only code shared by the server and the add-in.
			It must stay free of Inventor interop so the server never needs Inventor installed to build.
		-->
		<RootNamespace>InventorMcp.Contracts</RootNamespace>

		<!--
			Temporary. The add-in targets net8.0-windows for Inventor 2025 and 2026, which host .NET 8,
			so the shared contract has to sit at or below that. The net10.0 server references it happily.
			Not netstandard2.0: that only earns its place when net48 is a target, and it never is here.
			Delete this line when Inventor 2025 and 2026 move to .NET 10, so the project inherits
			TargetFramework from Directory.Build.props again. See Docs/Tasks/Multi-Version-Support.md.
		-->
		<TargetFramework>net8.0</TargetFramework>
	</PropertyGroup>

</Project>
