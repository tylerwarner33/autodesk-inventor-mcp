<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<RepoRootDir>$(MSBuildThisFileDirectory)</RepoRootDir>

		<TargetFramework>net10.0</TargetFramework>

		<Version>0.2.0</Version>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!--
			The build enforces the code rules, so an agent sees a broken rule as a build error and fixes it.
			Recommended, not All: All adds rules that are wrong for a COM add-in (ex. CA2007 ConfigureAwait).
			.editorconfig sets the severity of each style rule. See Docs/Architecture.md, "The build enforces the code rules".
		-->
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<!-- Symbols live in the assembly, which matters for an add-in Inventor loads straight from a build folder. -->
		<DebugType>embedded</DebugType>

		<!-- Makes a build on GitHub Actions deterministic. A local build keeps real source paths. -->
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- Keeps the output path stable, so .mcp.json does not have to name the target framework. -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<!-- Audits transitive packages too, which is where the Roslyn scripting dependencies arrive. -->
		<NuGetAuditMode>all</NuGetAuditMode>
	</PropertyGroup>

	<!--
		The Inventor release being built. Override with -p:AutodeskVersion=2025.
		The interop is vendored under Libs so an agent with no Inventor installed can still build.
		Only the add-in is version bound; the server is built once.
	-->
	<PropertyGroup>
		<AutodeskVersion Condition="'$(AutodeskVersion)' == ''">2027</AutodeskVersion>

		<!-- Every supported release, so one command can loop them. -->
		<SupportedAutodeskVersions>2025;2026;2027</SupportedAutodeskVersions>
	</PropertyGroup>

	<!--
		Everything that follows from the release.
		AddInTargetFramework is Inventor's hosted runtime, not a preference.
		InventorSoftwareVersion is what the .addin manifest filters on, not the release year.
		UseAddInLoader marks releases that ignore UseInventorAssemblyContext, so InventorMcp.AddIn.Loader isolates the add-in.
		See Docs/Architecture.md.
	-->
	<Choose>
		<When Condition="'$(AutodeskVersion)' == '2025'">
			<PropertyGroup>
				<AddInTargetFramework>net8.0-windows</AddInTargetFramework>
				<InventorSoftwareVersion>29</InventorSoftwareVersion>
				<UseAddInLoader>true</UseAddInLoader>
			</PropertyGroup>
		</When>
		<When Condition="'$(AutodeskVersion)' == '2026'">
			<PropertyGroup>
				<AddInTargetFramework>net8.0-windows</AddInTargetFramework>
				<InventorSoftwareVersion>30</InventorSoftwareVersion>
				<UseAddInLoader>true</UseAddInLoader>
			</PropertyGroup>
		</When>
		<When Condition="'$(AutodeskVersion)' == '2027'">
			<PropertyGroup>
				<AddInTargetFramework>net10.0-windows</AddInTargetFramework>
				<InventorSoftwareVersion>31</InventorSoftwareVersion>
			</PropertyGroup>
		</When>
		<Otherwise>
			<PropertyGroup>
				<!-- Still a valid framework, so the failure is the error below and not a confusing SDK message. -->
				<AddInTargetFramework>net10.0-windows</AddInTargetFramework>
				<UnsupportedAutodeskVersion>true</UnsupportedAutodeskVersion>
			</PropertyGroup>
		</Otherwise>
	</Choose>

	<PropertyGroup>
		<InventorInstallDir>$(ProgramFiles)\Autodesk\Inventor $(AutodeskVersion)</InventorInstallDir>
		<InventorInteropDir>$(RepoRootDir)Libs\Inventor\$(AutodeskVersion)</InventorInteropDir>

		<!-- Read by the development deployment target, which writes to a version specific folder. -->
		<IsInventorInstalled Condition="Exists('$(InventorInstallDir)\Bin\Inventor.exe')">true</IsInventorInstalled>
	</PropertyGroup>

	<Target Name="ValidateAutodeskVersion" BeforeTargets="PrepareForBuild" Condition="'$(UnsupportedAutodeskVersion)' == 'true'">
		<Error Text="AutodeskVersion '$(AutodeskVersion)' is not supported. Supported releases: $(SupportedAutodeskVersions)." />
	</Target>
</Project>
